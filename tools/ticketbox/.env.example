# Copy thành tools/ticketbox/.env (git-ignored) và đặt mật khẩu thật.
# db/init/*.sql chỉ chạy khi volume được tạo lần đầu.
# Reset (xoá toàn bộ dữ liệu): docker compose -f tools/ticketbox/compose.yaml down -v
TICKETBOX_DB_HOST=127.0.0.1
TICKETBOX_DB_PORT=5434
TICKETBOX_DB_NAME=ticketbox
TICKETBOX_DB_USER=ticketbox
TICKETBOX_DB_PASSWORD=change-me
